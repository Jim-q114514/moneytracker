{
  "expo": {
    "name": "MoneyTracker",
    "slug": "moneytracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "moneytracker",
    "splash": {
      "backgroundColor": "#F2F2F7",
      "dark": {
        "backgroundColor": "#000000"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aramco.cycomm",
      "infoPlist": {
        "CFBundleDisplayName": "MoneyTracker",
        "CFBundleShortVersionString": "1.0.0",
        "CFBundleVersion": "1",
        "LSApplicationQueriesSchemes": [
          "moneytracker"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UIUserInterfaceStyle": "Automatic",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "MoneyTracker 不会使用相机。",
        "NSPhotoLibraryUsageDescription": "MoneyTracker 不会使用相册。"
      }
    },
    "plugins": [
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "b0ff2f80-08d4-4830-8024-1e856577a2c6"
      }
    }
  }
}
